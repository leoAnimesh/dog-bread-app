# Base URL of the Dog API v2 (no key required)
EXPO_PUBLIC_API_BASE_URL=https://dogapi.dog/api/v2

# Page size used when assembling the breed dataset (API caps at 48)
EXPO_PUBLIC_API_PAGE_SIZE=48

# Cached data is considered stale after this many minutes and is re-synced in the background
EXPO_PUBLIC_STALE_AFTER_MINUTES=60

# On-disk budget for cached breed images (thumb + medium + large variants), LRU evicted
EXPO_PUBLIC_IMAGE_CACHE_LIMIT_MB=60

# Debounce for the breed search field, in milliseconds
EXPO_PUBLIC_SEARCH_DEBOUNCE_MS=300
